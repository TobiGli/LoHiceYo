# Copia este archivo a ".env" para correr localmente.
# En Render, estas mismas variables se cargan en Settings -> Environment.

PORT=3000

# Zona horaria usada para saber cuándo es "el último día del mes".
TZ=America/Argentina/Buenos_Aires

# Base de datos en Turso (gratis, persistente - ver README "Base de datos").
# Si las dejás vacías, la app usa un archivo SQLite local (sirve para probar
# en tu computadora, pero en Render se borraría con cada deploy).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Solo se usa si TURSO_DATABASE_URL está vacío (desarrollo local).
DB_PATH=./data/tasks.db

# Claves VAPID para las notificaciones push (generalas con: npm run generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Secreto para proteger el endpoint /api/cron/finalize (llamado por un cron externo)
CRON_SECRET=cambiar-por-un-secreto-largo
